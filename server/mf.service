[Unit]
Description=Min friluft
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/<url>
ExecStart=/usr/bin/node /var/www/<url>/server/src/server.js
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15
Environment=NODE_ENV=production
Environment=STATIC_ROOT=

[Install]
WantedBy=multi-user.target