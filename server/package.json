{
  "name": "min-friluft-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST-API for Min friluft: turer, bilder og notater, lagret i SQLite",
  "main": "src/server.js",
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "create-user": "node scripts/create-user.js",
    "import-demo": "node scripts/import-demo.js",
    "test": "node --test",
    "test:e2e": "playwright test --config e2e/playwright.config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true
  }
}
